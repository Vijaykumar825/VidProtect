# Pulse Video Backend Environment Variables - PRODUCTION
# These values are ready for deployment on Render

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pulse-video

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# File Upload Configuration
MAX_FILE_SIZE=104857600

# Frontend URL (for CORS) - Vercel deployment
FRONTEND_URL=https://vid-protect-sn6l.vercel.app
